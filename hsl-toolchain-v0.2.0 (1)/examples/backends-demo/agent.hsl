// ============================================================================
// examples/backends-demo/agent.hsl — 38 后端投射演示 · 入口与拓扑
// ----------------------------------------------------------------------------
// 本项目把同一份逻辑投射到全部 38 个后端（32 编程语言 + 6 静态格式），
// 演示 project{} 的多语言散布能力。运行：
//   bun dhv-ts/src/main.ts emit examples/backends-demo/agent.hsl --out /tmp/backends-demo
// ============================================================================

import { Prompt, ToolResult, Action, Verdict, LLMProvider, describe_action, clamp_turns, summarize } from "./model.hsl";

const MAX_TURNS: i64 = 24;
const state_budget: i64 = 12;

fn main() -> i64 {
    let p = Prompt::new(String::from("sys"), String::from("usr"));
    println!("len={}", p.total_len());
    println!("{}", describe_action(Action::Stop));
    let results = vec![
        ToolResult { tool: String::from("bash"), output: String::from("ok"), ok: true },
        ToolResult { tool: String::from("grep"), output: String::from("miss"), ok: false },
    ];
    println!("{}", summarize(results));
    0
}

graph DemoAgent {
    let planner: Prompt = Prompt::new(String::from("you are a demo agent"), String::from("run"));
    let budget: i64 = clamp_turns(12, 1, 24);

    loop {
        let action = Action::Stop;
        match action {
            Action::CallTool { name, args } => {
                let result = ToolResult { tool: name, output: format!("{} args · budget={}", args.len(), budget), ok: true };
                println!("tool: {}", result.output);
                continue;
            },
            Action::Respond { text } => {
                println!("{} · planner={}", text, planner.total_len());
                break;
            },
            Action::Stop => break,
        }
    }
}

block agent_config {
    agent:
      name: BackendsDemo
      version: 2
      max_turns: {{MAX_TURNS}}
      languages: 38
}

block agent_instructions {
    # Backends Demo Agent
    这是一个跨 38 后端的投射演示。
    当前预算：{{state_budget}} 轮。
}

scale = microkernel;

project {
    // ---- Tier 1 · Harness 核心（10）----
    Prompt          -> "gen/python/prompt.py"          : python,
