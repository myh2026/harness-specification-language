trait Fn2 { fn apply(self, x: i64) -> i64; }
struct Double {}
impl Fn2 for Double { fn apply(self, x: i64) -> i64 { x * 2 } }

fn main() -> Result<(), String> {
    let d = Box::new(Double {});
    println!("direct_box={}", d.apply(4));

    let plain = Double {};
    println!("plain={}", plain.apply(5));

    let v: Vec<Box<dyn Fn2>> = vec![Box::new(Double {})];
    for b in v {
        println!("for_box={}", b.apply(6));
    }

    let v2: Vec<Box<dyn Fn2>> = vec![Box::new(Double {}), Box::new(Double {})];
    println!("index_box={}", v2[1].apply(7));
    Ok(())
}