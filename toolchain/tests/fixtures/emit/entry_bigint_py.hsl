// ============================================================================
// tests/fixtures/emit/entry_bigint_py.hsl — 行为级对拍语料：大整数精度（python 单端）
// ----------------------------------------------------------------------------
// L-9c 声明域：js/ts Number 安全域外（±2^53-1）整数字面量读入即静默舍入
// （9007199254740993 → 9007199254740992），emit 期已有显式告警 —— 本语料
// 只投射 python（interp BigInt 任意精度与 python 原生大整数精确一致）。
// js 端的舍入为已文档化的投射差异，不纳入三端对拍（防「已知漂移」污染护栏）。
// ============================================================================

export fn main() -> i64 {
    let big: i64 = 9007199254740993;
    println!("emit::big={}", big);
    println!("emit::big2={}", big + 1);
    println!("emit::big3={}", big * 1000000000);
    0
}

project {
    main -> "gen/python/main.py" : python,
}
