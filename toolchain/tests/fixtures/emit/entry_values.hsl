// ============================================================================
// tests/fixtures/emit/entry_values.hsl — 行为级对拍语料：字面量与显示族
// ----------------------------------------------------------------------------
// L-19/L-21 锁定：整值浮点显示 JS 风格（3.0 → '3'）、bool 小写（true）、
// 精确浮点最短往返表示（0.1+0.2 → 0.30000000000000004 三端一致）。
// ============================================================================

export fn main() -> i64 {
    println!("emit::int={}", 42);
    println!("emit::neg={}", -17);
    println!("emit::float1={}", 1.5 + 2.25);
    println!("emit::float2={}", 3.0);
    println!("emit::float3={}", 0.1 + 0.2);
    println!("emit::float4={}", 0.5 * 0.25);
    println!("emit::str={}", String::from("héllo"));
    println!("emit::bool={}", 3 > 2);
    println!("emit::boolf={}", 1 > 2);
    0
}

project {
    main -> "gen/python/main.py"     : python,
    main -> "gen/javascript/main.js" : javascript,
}
