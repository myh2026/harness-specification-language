// v0.2.56 S-17 合法族：cast 域折叠（truncation-aware）—— 折叠后域内不误报
fn main() {
  let a: u8 = 300 as u8 + 200;      // 44 + 200 = 244 域内
  let b: i8 = 200 as i8 + 100;      // -56 + 100 = 44 域内
  let c: u8 = 300 as u8;            // 44 直通
  let d: i16 = 70000 as i16;        // 4464 环绕后域内
  let e: u32 = 300 as u8 * 2;       // 44 * 2 = 88 域内
  println!("{} {} {} {} {}", a, b, c, d, e);
}
