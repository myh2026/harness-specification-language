// 回归锁定：内联 for-range（`for i in a..b` / `for i in a..=b`），双编译器一致。
// v0.2.28 修复：dhv-ts 解析器消费 a..b 为 range expr 后，
// body.ts for 处理需检测 iter.kind === 'range' 以激活 forRangeLines。

export fn inline_open(a: i64, b: i64) -> i64 {
    let mut acc: i64 = 0;
    for i in a..b {
        acc = acc + i;
    }
    acc
}

export fn inline_closed(a: i64, b: i64) -> i64 {
    let mut acc: i64 = 0;
    for i in a..=b {
        acc = acc + i;
    }
    acc
}

export fn inline_literal() -> i64 {
    let mut acc: i64 = 0;
    for i in 0..5 {
        acc = acc + i;
    }
    acc
}
