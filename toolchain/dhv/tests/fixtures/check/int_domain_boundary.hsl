// 边界值全合法（S13 不误报）：i8 ±127/-128、i64 MAX、u8 255/0xFF、u64 MAX。
export fn f() -> i64 {
    let a: i8 = -128;
    let b: i8 = 127;
    let c: i64 = 9223372036854775807;
    let d: u8 = 255;
    let e: u8 = 0xFF;
    let g: u64 = 18446744073709551615;
    (a + b + (c > 0) as i64 + (d > 0) as i64 + (e > 0) as i64 + (g > 0) as i64)
}
