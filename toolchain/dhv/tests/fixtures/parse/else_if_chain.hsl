// 回归锁定：if / else if / else 链（含块尾裸表达式）
// 此前 `if turns > hi { hi }` 中 `hi { hi }` 被贪婪解析为简写字段的结构体字面量，
// 吞掉 if 块 → else 悬空 → 语法错误（no-struct 语境阶梯修复，BNF §2.11.7）。
export fn clamp_turns(turns: i64, lo: i64, hi: i64) -> i64 {
    if turns < lo {
        lo
    } else if turns > hi {
        hi
    } else {
        turns
    }
}

export fn pick(x: i64) -> String {
    if x > 0 {
        String::from("pos")
    } else if x == 0 {
        String::from("zero")
    } else if x > -10 {
        String::from("small")
    } else {
        String::from("neg")
    }
}
