// 值域语料 5：模式位（match 臂字面量/元组模式/守卫 if）
fn main() {
  let n = 5;
  match n {
    1 => println!("one"),
    2 | 3 => println!("two-or-three"),
    4 => println!("four"),
    _ => println!("many"),
  }
  let pair = (0, 9);
  match pair {
    (0, y) => println!("zero-{}", y),
    (x, 0) => println!("{}-zero", x),
    _ => println!("other"),
  }
}
