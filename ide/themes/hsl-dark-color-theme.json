{
  "$schema": "vscode://schemas/color-theme",
  "name": "HSL Dark (amber keynote)",
  "type": "dark",
  "colors": {
    "editor.background": "#0a0a0a",
    "editor.foreground": "#f5f0e8",
    "editorLineNumber.foreground": "#3f3f46",
    "editorLineNumber.activeForeground": "#f59e0b",
    "editor.selectionBackground": "#f59e0b33",
    "editor.lineHighlightBackground": "#ffffff08",
    "editorCursor.foreground": "#f59e0b",
    "editorIndentGuide.background1": "#27272a",
    "editorIndentGuide.activeBackground1": "#52525b",
    "editorGutter.background": "#0a0a0a",
    "sideBar.background": "#050505",
    "sideBar.foreground": "#d4d4d8",
    "activityBar.background": "#050505",
    "activityBarBadge.background": "#f59e0b",
    "titleBar.activeBackground": "#050505",
    "statusBar.background": "#050505",
    "statusBar.foreground": "#a1a1aa",
    "tab.activeBackground": "#0a0a0a",
    "tab.activeBorderTop": "#f59e0b",
    "tab.inactiveBackground": "#050505",
    "terminal.background": "#050505",
    "focusBorder": "#f59e0b66",
    "button.background": "#f59e0b",
    "button.foreground": "#0a0a0a"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#52525b", "fontStyle": "italic" } },
    { "scope": "keyword.control.graph, keyword.control.edge, keyword.control.node, keyword.control.projection, keyword.control.native", "settings": { "foreground": "#f59e0b", "fontStyle": "bold" } },
    { "scope": "keyword.control.flow", "settings": { "foreground": "#fbbf24" } },
    { "scope": "keyword.control.definition", "settings": { "foreground": "#f59e0b" } },
    { "scope": "support.type.primitive", "settings": { "foreground": "#34d399" } },
    { "scope": "support.type.collection", "settings": { "foreground": "#34d399" } },
    { "scope": "entity.name.type, entity.name.type.graph", "settings": { "foreground": "#a3e635" } },
    { "scope": "string", "settings": { "foreground": "#fde68a" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#fb923c" } },
    { "scope": "constant.language.boolean, constant.language.scale-mode, constant.language.target-lang, constant.language.native-lang", "settings": { "foreground": "#f472b6" } },
    { "scope": "entity.name.function.macro, entity.name.macro", "settings": { "foreground": "#e879f9" } },
    { "scope": "variable.other.macro.fragment", "settings": { "foreground": "#e879f9", "fontStyle": "italic" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#34d399", "fontStyle": "bold" } },
    { "scope": "entity.name.label", "settings": { "foreground": "#f472b6" } },
    { "scope": "meta.interpolation", "settings": { "foreground": "#f59e0b", "fontStyle": "bold" } },
    { "scope": "punctuation.definition.interpolation", "settings": { "foreground": "#f59e0b" } }
  ]
}
